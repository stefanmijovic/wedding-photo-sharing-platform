# Runtime
NODE_ENV=development
PORT=3000

# Public application origins (comma-separated; required in production)
ALLOWED_ORIGINS=https://wedding.example.com

# Authentication and sessions
SESSION_SECRET=change-me-to-a-long-random-secret-with-at-least-32-characters
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=change-this-password

# Event schedule (ISO 8601 with an explicit UTC offset)
EVENT_UNLOCK_AT=2030-06-15T08:00:00+02:00
WEDDING_AT=2030-06-15T14:00:00+02:00

# Notification recipients and links
ADMIN_EMAIL=admin@example.com
ADMIN_PANEL_URL=https://wedding.example.com/admin.html
COUPLE_NOTIFICATION_EMAIL=couple@example.com
COUPLE_PANEL_URL=https://wedding.example.com/admin.html

# Must be an absolute path outside the public uploads directory
# Windows example: D:\\wedding-private\\voice-messages
# Linux example: /var/lib/wedding-app/voice-messages
VOICE_MESSAGES_DIR=/absolute/path/to/private/voice-messages
